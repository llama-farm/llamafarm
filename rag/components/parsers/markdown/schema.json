{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Markdown Parser Configuration",
  "description": "Configuration schema for Markdown parser",
  "type": "object",
  "properties": {
    "chunk_size": {
      "type": ["integer", "null"],
      "minimum": 50,
      "maximum": 10000,
      "description": "Size of text chunks. null means no chunking"
    },
    "chunk_overlap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 0,
      "description": "Number of characters to overlap between chunks"
    },
    "chunk_strategy": {
      "type": "string",
      "enum": ["markdown_aware", "paragraphs", "sentences", "characters"],
      "default": "markdown_aware",
      "description": "Strategy for splitting markdown into chunks"
    },
    "preserve_structure": {
      "type": "boolean",
      "default": true,
      "description": "Preserve markdown heading hierarchy"
    },
    "extract_code_blocks": {
      "type": "boolean",
      "default": true,
      "description": "Extract code blocks as separate chunks"
    },
    "extract_links": {
      "type": "boolean",
      "default": true,
      "description": "Extract and store link references"
    },
    "extract_images": {
      "type": "boolean",
      "default": true,
      "description": "Extract image references"
    }
  },
  "additionalProperties": false
}