{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PDF Parser Configuration",
  "description": "Configuration schema for PDF parser",
  "type": "object",
  "properties": {
    "chunk_size": {
      "type": ["integer", "null"],
      "minimum": 50,
      "maximum": 10000,
      "description": "Size of text chunks. null means no chunking"
    },
    "chunk_overlap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 0,
      "description": "Number of characters/tokens to overlap between chunks"
    },
    "chunk_strategy": {
      "type": "string",
      "enum": ["characters", "sentences", "paragraphs", "semantic"],
      "default": "sentences",
      "description": "Strategy for splitting text into chunks"
    },
    "return_full_document": {
      "type": "boolean",
      "default": false,
      "description": "Return entire PDF as single document vs per-page"
    },
    "extract_tables": {
      "type": "boolean",
      "default": false,
      "description": "Extract tables using camelot or pdfplumber"
    },
    "extract_images": {
      "type": "boolean",
      "default": false,
      "description": "Extract and process images from PDF"
    },
    "extract_forms": {
      "type": "boolean",
      "default": false,
      "description": "Extract form fields and values"
    },
    "ocr_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable OCR for scanned PDFs"
    },
    "ocr_language": {
      "type": "string",
      "default": "eng",
      "description": "Tesseract language code for OCR"
    },
    "ocr_dpi": {
      "type": "integer",
      "minimum": 72,
      "maximum": 600,
      "default": 300,
      "description": "DPI for OCR image conversion"
    },
    "preserve_formatting": {
      "type": "boolean",
      "default": false,
      "description": "Preserve original formatting (bold, italic, etc.)"
    },
    "extract_metadata": {
      "type": "boolean",
      "default": true,
      "description": "Extract PDF metadata (author, title, etc.)"
    },
    "clean_text": {
      "type": "boolean",
      "default": true,
      "description": "Clean extracted text (remove extra spaces, etc.)"
    },
    "page_range": {
      "type": ["array", "null"],
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Page range to extract [start, end]. null for all pages"
    }
  },
  "additionalProperties": false
}