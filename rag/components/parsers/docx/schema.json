{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DOCX Parser Configuration",
  "description": "Configuration schema for DOCX parser",
  "type": "object",
  "properties": {
    "chunk_size": {
      "type": ["integer", "null"],
      "minimum": 50,
      "maximum": 10000,
      "description": "Size of text chunks. null means no chunking"
    },
    "chunk_overlap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 0,
      "description": "Number of characters to overlap between chunks"
    },
    "chunk_strategy": {
      "type": "string",
      "enum": ["characters", "sentences", "paragraphs"],
      "default": "paragraphs",
      "description": "Strategy for splitting text into chunks"
    },
    "extract_images": {
      "type": "boolean",
      "default": false,
      "description": "Extract embedded images"
    },
    "preserve_formatting": {
      "type": "boolean",
      "default": false,
      "description": "Preserve text formatting (bold, italic, etc.)"
    },
    "extract_tables": {
      "type": "boolean",
      "default": true,
      "description": "Extract and convert tables"
    },
    "extract_headers_footers": {
      "type": "boolean",
      "default": false,
      "description": "Extract document headers and footers"
    }
  },
  "additionalProperties": false
}